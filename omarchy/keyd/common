# Shared Mac keymap; default.conf and mac.conf only decide which physical keys are Cmd and Option. Ctrl stays Ctrl.
[main]
capslock = layer(hyper)
# Mac-mode keyboards send their Caps-Hyper as Ctrl + Option + Cmd; as a chord it opens Hyper instead of three separate layers.
leftcontrol+leftalt+leftmeta = layer(hyper)

[hyper:C-A-M]

# Option: Alt, except a/o/u/s and 2/3/4 send AltGr so the layout's ä/ö/ü/ß and €/£ arrive as text in every app.
[option:A]
a = G-a
o = G-o
u = G-u
s = G-s
2 = G-2
3 = G-3
4 = G-4
left = C-left
right = C-right
backspace = C-backspace
delete = C-delete

# Cmd sends Ctrl so app shortcuts match macOS; the system ones Hyprland keeps on Super are mapped across.
[cmd:C]
q = M-q
# The switcher commits when Super is released, so Super has to stay held for as long as Cmd is.
tab = swapm(cmdtab, tab)
space = M-space
h = M-S-h
m = M-S-h
left = home
right = end
up = C-home
down = C-end
backspace = macro(S-home backspace)

# Super stays held here, so Esc reaches Hyprland's alttab submap as Super + Esc and cancels the switcher.
[cmdtab:M]

# Cmd + Shift + 3/4 screenshots and Cmd + Shift + V clipboard history; Hyprland has them on Super, which no physical key sends anymore.
[cmd+shift]
3 = M-S-3
4 = M-S-4
v = M-C-v

# Ctrl + Cmd + Space is the macOS emoji picker; Omarchy opens its picker on Super + Ctrl + E.
[cmd+control]
space = M-C-e
