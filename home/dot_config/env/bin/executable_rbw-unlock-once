#!/bin/sh
# One pinentry for racing callers: waiters reuse its result, and a cancel holds off new prompts for a minute.
set -u

rbw unlocked >/dev/null 2>&1 && exit 0

# rbw hands its stdin tty to pinentry; without one, keep it off the caller's stdin.
[ -t 0 ] || exec </dev/null

dir=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
name=rbw-unlock
if [ ! -d "$dir" ]; then
  dir=${TMPDIR:-/tmp}
  name="rbw-unlock-$(id -u)"
fi
cancelled="$dir/$name.cancelled"

unlock() {
  if [ -n "$(find "$cancelled" -mmin -1 2>/dev/null)" ]; then
    exit 1
  fi
  if rbw unlock >/dev/null 2>&1 && rbw unlocked >/dev/null 2>&1; then
    rm -f "$cancelled"
    exit 0
  fi
  : > "$cancelled"
  exit 1
}

if ! command -v flock >/dev/null 2>&1; then
  unlock
fi

exec 9>"$dir/$name.lock"
flock -w 120 9 || exit 1
rbw unlocked >/dev/null 2>&1 && exit 0
unlock
