#!/bin/sh
# Launch an AI agent CLI with its rbw secret profile, gateway settings and the optional LAN CA.
set -eu

ENV_DIR="${ENV_DIR:-$HOME/.config/env}"

usage() {
  printf '%s\n' 'usage: agent-run <claude|claude-hass|claude-sub|codex|omp|opencode> [args...]' >&2
  exit 2
}

# readlink -f only exists from macOS 12.3 on.
resolve() {
  r=$1
  while [ -L "$r" ]; do
    l=$(readlink "$r")
    case $l in
      /*) r=$l ;;
      *) r=$(dirname "$r")/$l ;;
    esac
  done
  printf '%s/%s\n' "$(cd -P "$(dirname "$r")" && pwd -P)" "${r##*/}"
}

self=$(resolve "$0")
launched=0
if [ "${1:-}" = --launch ]; then
  launched=1
  shift
fi
case ${0##*/} in
  agent-run)
    [ "$#" -gt 0 ] || usage
    client=$1
    shift
    ;;
  *) client=${0##*/} ;;
esac

drop=
gateway_url=0
local_token=1
fill_auth=0
require=
case $client in
  claude) bin=claude gateway_url=1 fill_auth=1 require=ANTHROPIC_AUTH_TOKEN ;;
  claude-hass)
    bin=claude gateway_url=1 local_token=0 require=ANTHROPIC_AUTH_TOKEN
    drop='ANTHROPIC_AUTH_TOKEN ANTHROPIC_API_KEY LITELLM_API LITELLM_API_KEY'
    ;;
  claude-sub)
    bin=claude
    drop='ANTHROPIC_BASE_URL ANTHROPIC_AUTH_TOKEN ANTHROPIC_API_KEY CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY
      ANTHROPIC_CUSTOM_MODEL_OPTION ANTHROPIC_CUSTOM_MODEL_OPTION_NAME ANTHROPIC_CUSTOM_MODEL_OPTION_DESCRIPTION'
    ;;
  codex) bin=codex ;;
  omp | opencode) bin=$client require=LITELLM_API ;;
  *) usage ;;
esac

# The first pass runs before rbw-env injects the profile; it re-enters with --launch.
if [ "$launched" = 0 ]; then
  # shellcheck disable=SC2086
  unset $drop
  if [ "$gateway_url" = 1 ]; then
    export ANTHROPIC_BASE_URL="${LITELLM_BASE_URL:-https://api.ai.h-cloud.lan}"
    export CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY=1
  fi
  if [ -z "${NODE_EXTRA_CA_CERTS:-}" ]; then
    for ca in "${LAN_CA_PATH:-}" "$HOME/.local/share/certs/lan-ca.pem" \
      /usr/local/share/ca-certificates/lan-ca.crt /etc/ssl/certs/lan-ca.pem; do
      if [ -n "$ca" ] && [ -r "$ca" ]; then
        export NODE_EXTRA_CA_CERTS="$ca"
        break
      fi
    done
  fi
  if command -v rbw >/dev/null 2>&1 && [ -x "$ENV_DIR/bin/rbw-env" ] && [ -r "$ENV_DIR/secrets/$client.envmap" ]; then
    RBW_ENV_STRICT=0 exec "$ENV_DIR/bin/rbw-env" "$client" -- "$self" --launch "$client" "$@"
  fi
fi

: "${LITELLM_API:=${LITELLM_API_KEY:-}}"
if [ -z "$LITELLM_API" ] && [ "$local_token" = 1 ]; then
  LITELLM_API=$("$ENV_DIR/bin/local-agents-token" 2>/dev/null) || LITELLM_API=
fi
if [ -n "$LITELLM_API" ]; then
  LITELLM_API_KEY=$LITELLM_API
  export LITELLM_API LITELLM_API_KEY
  if [ "$fill_auth" = 1 ]; then
    export ANTHROPIC_AUTH_TOKEN="${ANTHROPIC_AUTH_TOKEN:-$LITELLM_API}"
  fi
else
  unset LITELLM_API
fi

if [ -n "$require" ]; then
  eval "required=\${$require:-}"
  if [ -z "$required" ]; then
    printf 'agent-run: %s needs %s; unlock rbw or provision the local-agents token\n' "$client" "$require" >&2
    exit 1
  fi
fi

override_var=$(printf '%s_BIN' "$bin" | tr 'a-z-' 'A-Z_')
eval "real=\${$override_var:-}"
if [ -z "$real" ]; then
  old_ifs=$IFS
  IFS=:
  for dir in $PATH; do
    candidate="${dir:-.}/$bin"
    [ -f "$candidate" ] && [ -x "$candidate" ] || continue
    [ "$(resolve "$candidate")" = "$self" ] && continue
    real=$candidate
    break
  done
  IFS=$old_ifs
fi
if [ -z "$real" ]; then
  printf 'agent-run: %s not found on PATH\n' "$bin" >&2
  exit 127
fi
exec "$real" "$@"
