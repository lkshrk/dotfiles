              "max_tokens_parameter": false
            }
          }
        ]
      }
    },
    "opencode": {
      "show_zen_models": false
    }
  },
  "edit_predictions": {
    "provider": "zed",
  },
  "show_edit_predictions": false,
  "ssh_connections": [
    {
      "host": "hcloud",
      "projects": [
        {
          "paths": ["~/my-cluster"],
        },
      ],
    },
  ],
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "languages": {
    "C": {
      "remove_trailing_whitespace_on_save": false,
    },
    "Lua": {
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "stylua",
          "arguments": [
            "--syntax=Lua54",
            "--respect-ignores",
            "--stdin-filepath",
            "{buffer_path}",
            "-",
          ],
        },
      },
    },
  },
  "telemetry": {
    "metrics": false,
  },
  "terminal": {
    "font_size": 14,
  },
  "vim_mode": true,
  "ui_font_size": 14,
  "buffer_font_size": 14,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark",
  },
  "vertical_scroll_margin": 8,
  "tab_size": 2,
  "vim": {
    "use_system_clipboard": "on_yank",
  },
}
