            }
          },
          {
            "name": "deepseek-flash",
            "max_tokens": 1048576,
            "max_output_tokens": 393216,
            "capabilities": {
              "tools": true,
              "images": true,
              "parallel_tool_calls": true,
              "prompt_cache_key": false,
              "chat_completions": true,
