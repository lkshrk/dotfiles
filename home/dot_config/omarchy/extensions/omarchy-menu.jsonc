{
  // Overrides repeat icon and label: Omarchy fills omitted fields with defaults (label = id) instead of keeping the stock ones.

  // Quit apps whole instead of closing each window, so browsers keep all their windows.
  "system.logout": {"icon":"󰍃","label":"Logout","action":"~/.config/hypr/scripts/power logout"},
  "system.reboot": {"icon":"󰜉","label":"Reboot","action":"~/.config/hypr/scripts/power reboot"},
  "system.shutdown": {"icon":"󰐥","label":"Shutdown","action":"~/.config/hypr/scripts/power poweroff"},

  // Omarchy's list shows its Super defaults, which keyd leaves no key for; this one lists bindings.lua.
  "learn.keybindings": {"icon":"","label":"Keybindings","action":"~/.config/hypr/scripts/keybindings"},

  // Quotatank is a bar plugin, not an app, so it only appears here through its IPC handler.
  "quota": {"icon":"󰊚","label":"LLM Quota","description":"Quotatank usage and limits","aliases":["quotatank"],"action":"quickshell ipc -p /usr/share/omarchy/shell call janitorhead.quotatank toggle"},
}
