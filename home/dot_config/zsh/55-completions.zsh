# Generated by ~/.config/env/bin/zsh-completions; the omp wrapper would block on rbw at shell start.
[[ -s ${XDG_CACHE_HOME:-$HOME/.cache}/zsh/omp-completions.zsh ]] && source ${XDG_CACHE_HOME:-$HOME/.cache}/zsh/omp-completions.zsh

# A manual `mise upgrade` leaves the shims untouched, so the install dirs tell whether kubectl or flux changed.
() {
  local dir=${XDG_CACHE_HOME:-$HOME/.cache}/zsh/completions installs=${MISE_DATA_DIR:-$HOME/.local/share/mise}/installs
  local name tool bin
  for name tool in kubectl kubectl flux flux2; do
    (( $+commands[$name] )) || continue
    bin=${commands[$name]:A}
    [[ $commands[$name] == */mise/shims/* ]] && bin=$installs/$tool
    if [[ $bin -nt $dir/_$name ]]; then
      "${ENV_DIR:-$HOME/.config/env}/bin/zsh-completions" &>/dev/null &!
      return
    fi
  done
}

# Wrapper functions and the words they stand for; aliases complete as their expansion.
typeset -gA _alias_comp_base=(ga 'git add' fxr 'flux reconcile')

_alias_complete() {
  local base=(${=${_alias_comp_base[$words[1]]:-$aliases[$words[1]]}}) w=("${words[@]}") c=$CURRENT st
  words=($base "${w[2,-1]}")
  (( CURRENT = c + ${#base} - 1 ))
  if (( $+functions[_${base[1]}] )); then _${base[1]}; else _default; fi
  st=$?
  words=("${w[@]}")
  CURRENT=$c
  return $st
}

(( $+functions[compdef] )) &&
  compdef _alias_complete ${(k)_alias_comp_base} ${(k)aliases[(R)(kubectl|flux|talosctl) *]}
