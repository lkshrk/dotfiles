[tools]
{{- if eq .chezmoi.os "linux" }}
# The plain Linux asset segfaults before main on glibc 2.44 (DeusData/codebase-memory-mcp#2763).
"github:DeusData/codebase-memory-mcp" = { version = "latest", asset_pattern = "codebase-memory-mcp-linux-amd64-portable.tar.gz" }
{{- else }}
"github:DeusData/codebase-memory-mcp" = "latest"
{{- end }}
"npm:context-mode" = "latest"
"pipx:obsidian-wiki" = "latest"
rtk = "latest"
{{- if eq .chezmoi.os "darwin" }}
# On Omarchy these come from its packages or its own mise layer.
copilot-cli = "latest"
claude = { version = "latest", auto_update = "4h" }
codex = { version = "latest", auto_update = "4h" }
oh-my-pi = { version = "latest", auto_update = "4h" }
opencode = { version = "latest", auto_update = "4h" }
{{- end }}
