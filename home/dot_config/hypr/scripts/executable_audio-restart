#!/usr/bin/env bash
# Resets the RODE input; --chain restarts the mic chain; CANDIDATE trials a chain config and rolls back on failure; --full restarts PipeWire and what does not reconnect.
set -u

conf="$HOME/.config/pipewire/filter-chain.conf.d/mic-filtered.conf"
rode_card="alsa_card.usb-RODE_Microphones_RODE_NT-USB-00"
rode_node="alsa_input.usb-RODE_Microphones_RODE_NT-USB-00.analog-stereo"
candidate=${1:-}
units=(pipewire.socket pipewire-pulse.socket pipewire.service pipewire-pulse.service wireplumber.service filter-chain.service pipeweaver.service)

say() { printf '%s\n' "$*"; }

# A crash-looping PipeWire trips systemd's start limit on the socket too, so both are reset.
restart_stack() {
  systemctl --user stop wireplumber.service pipewire-pulse.service pipewire.service pipewire-pulse.socket pipewire.socket
  systemctl --user reset-failed "${units[@]}" 2>/dev/null
  systemctl --user start pipewire.socket pipewire-pulse.socket
  systemctl --user start pipewire.service pipewire-pulse.service wireplumber.service filter-chain.service pipeweaver.service
  sleep 4
}

chain_invocation() { systemctl --user show filter-chain.service -p InvocationID --value; }

restart_chain() {
  systemctl --user reset-failed filter-chain.service 2>/dev/null
  systemctl --user restart filter-chain.service
  inv=$(chain_invocation)
  sleep 3
}

# Only the new instance counts: PipeWire 1.6.9 can segfault while the old chain shuts down (combine-stream teardown race).
load_failures() {
  journalctl --user _SYSTEMD_INVOCATION_ID="$inv" + USER_INVOCATION_ID="$inv" -o cat --no-pager |
    grep -iE "can't (load|create|find|make|start|open|parse|link)|cannot (create|find)|could not open|config file error|syntax error|failed to load|core-dump|dumped core"
}

chain_healthy() {
  [ "$(systemctl --user is-active filter-chain)" = active ] || return 1
  [ "$(chain_invocation)" = "$inv" ] || return 1
  pw-dump 2>/dev/null | jq -e '.[] | select(.info.props."node.name"? == "mic_filtered")' >/dev/null || return 1
  ! load_failures >/dev/null
}

# Portals give up on PipeWire after repeated failures and never retry, which breaks screen sharing until they restart.
restart_portals() {
  systemctl --user restart xdg-desktop-portal-hyprland.service xdg-desktop-portal.service
  sleep 2
  if "$(dirname "$0")/portal-ok" ScreenCast; then
    say "portals: screen sharing answers"
  else
    say "portals: screen sharing does NOT answer"
  fi
}

# These keep a dead PipeWire connection and need their own restart (OBS: reload the capture source instead).
stale_apps() {
  local found=()
  for app in Discord equibop obs signal-desktop brave helium; do
    pgrep -x "$app" >/dev/null 2>&1 && found+=("$app")
  done
  ((${#found[@]})) && say "reconnect these by hand: ${found[*]} (OBS: open the capture source and pick it again)"
}

default_mic() {
  say "default mic: $(wpctl inspect @DEFAULT_AUDIO_SOURCE@ 2>/dev/null | sed -n 's/.*node.name = "\(.*\)"/\1/p' | head -1)"
}

# Cycling the card profile rebuilds only the RODE node, which clears its start-order xruns without stranding clients.
reset_rode() {
  local id profile
  id=$(pw-dump 2>/dev/null | jq -r --arg n "$rode_card" '.[] | select(.type == "PipeWire:Interface:Device" and .info.props."device.name" == $n) | .id')
  [ -n "$id" ] || { say "RODE: not connected"; return 1; }
  profile=$(pw-dump 2>/dev/null | jq -r --argjson id "$id" '.[] | select(.id == $id) | .info.params.Profile[0].index')
  wpctl set-profile "$id" 0
  sleep 2
  wpctl set-profile "$id" "$profile"
  sleep 3
}

rode_xruns() {
  pw-top -b -n 6 2>/dev/null | awk -v n="$rode_node" '
    $1 == "S" && $2 == "ID" { s++ }
    s >= 2 && $NF == n { if (first == "") first = $9; last = $9 }
    END { print (first == "" ? "?" : last - first) }'
}

if [ -z "$candidate" ]; then
  reset_rode || exit 1
  say "RODE: $(rode_xruns) xruns in 5 s"
  default_mic
  exit 0
fi

if [ "$candidate" = --chain ]; then
  restart_chain
  if chain_healthy; then
    say "mic chain: healthy"
  else
    say "mic chain: NOT healthy"
    load_failures | sort | uniq -c | head -4
  fi
  default_mic
  exit 0
fi

if [ "$candidate" != --full ]; then
  [ -f "$candidate" ] || { say "no such file: $candidate"; exit 1; }
  good=$(mktemp)
  cp "$(readlink -f "$conf")" "$good"
  trap 'cp "$good" "$(readlink -f "$conf")"; rm -f "$good"; restart_chain' EXIT
  trap 'exit 130' INT TERM HUP
  cp "$candidate" "$(readlink -f "$conf")"
  restart_chain
  if chain_healthy; then
    say "candidate kept: $(readlink -f "$conf") now differs from git"
  else
    say "candidate failed live, restoring the previous config:"
    load_failures | sort | uniq -c | head -4
    cp "$good" "$(readlink -f "$conf")"
    restart_chain
  fi
  trap - EXIT
  rm -f "$good"
  say "mic chain: $(systemctl --user is-active filter-chain)"
  default_mic
  exit 0
fi

restart_stack
if [ "$(systemctl --user is-active pipewire)" != active ]; then
  say "PipeWire is DOWN"
  exit 2
fi
say "mic chain: $(systemctl --user is-active filter-chain)"
say "pipeweaver: $(systemctl --user is-active pipeweaver)"
restart_portals
default_mic
stale_apps
