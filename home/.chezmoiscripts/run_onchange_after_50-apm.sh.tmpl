{{- $groups := index .hosts .host | default (list) -}}
{{- if has "ai" $groups -}}
#!/bin/bash
# Installs the pinned patched APM build (lkshrk/apm, branch lk: MCP secrets stay references), then the global agent manifest.
# inputs: {{ include "dot_apm/apm.yml.tmpl" | sha256sum }} {{ include "../apm/ai-plugins/apm.yml" | sha256sum }}
set -euo pipefail
# Tools come from mise; this may run before a shell has put its shims on PATH (first setup).
export PATH="${MISE_DATA_DIR:-$HOME/.local/share/mise}/shims:$PATH"
version="0.35.1+lk.1"
url="https://github.com/lkshrk/apm/releases/download/v0.35.1%2Blk.1/apm_cli-0.35.1%2Blk.1-py3-none-any.whl"
sha256="c6e39dcb0465fa7363b48af5c164c9f607b70f6e4c1a193070aa2db1e7018e62"

installed=$(apm --version 2>/dev/null | awk '{print $NF}' || true)
if [ "$installed" != "$version" ]; then
  command -v uv >/dev/null 2>&1 || { echo "apm: uv is not installed" >&2; exit 1; }
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' EXIT
  wheel="$tmp/apm_cli-$version-py3-none-any.whl"
  curl -fsSL --proto '=https' -o "$wheel" "$url"
  if command -v sha256sum >/dev/null 2>&1; then
    actual=$(sha256sum "$wheel" | cut -d' ' -f1)
  else
    actual=$(shasum -a 256 "$wheel" | cut -d' ' -f1)
  fi
  [ "$actual" = "$sha256" ] || { echo "apm: wheel checksum mismatch" >&2; exit 1; }
  uv tool install --force "$wheel"
fi
# Plugins that declare their own MCP server sit behind the shared package; apm drops those unless trusted.
apm install -g --trust-transitive-mcp
{{- end }}
