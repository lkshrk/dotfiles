{{- $groups := index .hosts .host | default (list) -}}
{{- $lists := list -}}
{{- $aur := list -}}
{{- if eq .chezmoi.os "darwin" -}}
{{-   range $groups }}{{ $f := printf "packages/brew/%s.Brewfile" . }}{{ if stat (joinPath $.chezmoi.workingTree $f) }}{{ $lists = append $lists $f }}{{ end }}{{ end -}}
{{- else -}}
{{-   range $groups }}{{ $f := printf "packages/arch/%s.pacman" . }}{{ if stat (joinPath $.chezmoi.workingTree $f) }}{{ $lists = append $lists $f }}{{ end }}{{ end -}}
{{-   range $groups }}{{ $f := printf "packages/arch/%s.aur" . }}{{ if stat (joinPath $.chezmoi.workingTree $f) }}{{ $aur = append $aur $f }}{{ end }}{{ end -}}
{{- end -}}
#!/bin/bash
# Installs packages missing from this host's lists; chezmoi reruns it when a list changes.
# lists: {{ range (concat $lists $aur) }}{{ . }}={{ include (printf "../%s" .) | sha256sum }} {{ end }}
set -euo pipefail
cd {{ .chezmoi.workingTree | quote }}
{{ if eq .chezmoi.os "darwin" -}}
if ! command -v brew >/dev/null 2>&1; then
  for brew in /opt/homebrew/bin/brew /usr/local/bin/brew; do
    [ ! -x "$brew" ] || { eval "$("$brew" shellenv)"; break; }
  done
fi
command -v brew >/dev/null 2>&1 || { echo "packages: Homebrew is not installed; see https://brew.sh" >&2; exit 1; }
cat{{ range $lists }} {{ . | quote }}{{ end }} | brew bundle --no-upgrade --file=-
{{- else if stat "/etc/arch-release" -}}
mapfile -t pacman_pkgs < <(cat{{ range $lists }} {{ . | quote }}{{ end }} /dev/null | sort -u)
mapfile -t missing < <(pacman -T "${pacman_pkgs[@]}" || true)
if ((${#missing[@]})); then
  echo "packages: installing ${missing[*]}"
  pkexec /usr/bin/pacman -S --needed --noconfirm "${missing[@]}"
fi
{{- if $aur }}
mapfile -t aur_pkgs < <(cat{{ range $aur }} {{ . | quote }}{{ end }} | sort -u)
mapfile -t missing < <(pacman -T "${aur_pkgs[@]}" || true)
if ((${#missing[@]})); then
  command -v yay >/dev/null 2>&1 || { echo "packages: yay is needed for the AUR packages ${missing[*]}" >&2; exit 1; }
  echo "packages: installing from the AUR ${missing[*]}"
  yay -S --needed "${missing[@]}"
fi
{{- end }}
{{- end }}
