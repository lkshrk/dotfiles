# chezmoi writes copies, so app runtime files never land in the repo. Leftovers of the old Stow layout
# (e.g. an untracked gh hosts.yml) must not be committed.
/dotfiles/*
!/dotfiles/omni/
!/dotfiles/omni-apm/
!/dotfiles/omni-apm@topaz/
dotfiles/omni/.config/omni/*
!dotfiles/omni/.config/omni/settings.json
!dotfiles/omni/.config/omni/settings.d/
!dotfiles/omni/.config/omni/settings.d/**
