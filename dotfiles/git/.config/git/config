# Shared git config — device-specific settings live in config.local
[include]
	path = ~/.config/git/config.local
[push]
	autoSetupRemote = true
[pull]
	rebase = true
[gpg]
	format = ssh
[commit]
	gpgsign = true
[user]
	signingkey = /home/coder/.ssh/git-commit-signing/coder
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
