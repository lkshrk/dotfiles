#!/bin/bash

# Migrations rewrite configs through `mv "$tmp" "$file"`, which turns a dotfile symlink into a plain file and silently detaches it from the repo.
entries='^(hypr|omarchy-shell|keyd|xkb|fcitx5)$'

# The shell, and with it the notification daemon, may be mid-restart during an update.
alert() {
  hyprctl notify 0 15000 "rgb(ff5555)" "$1: $2" >/dev/null 2>&1 || logger -t check-dots-links "$1: $2"
}

if ! status=$(omni dots status --format json 2>/dev/null); then
  alert "Dotfile link check failed" "omni dots status exited with an error; run it by hand"
  exit 0
fi

drift=$(jq -r --arg re "$entries" '[.entries[]? | select((.name | test($re)) and .state != "synced") | "\(.name) (\(.state))"] | join(", ")' <<<"$status")

# Migrations that edit in place write through the symlinks into the repo; the age limit keeps older uncommitted work out.
repo=$HOME/Dev/dotfiles
edited=$(cd "$repo" 2>/dev/null && git status --porcelain -z -- dotfiles | cut -z -c4- |
  xargs -0 -r sh -c 'find "$@" -maxdepth 0 -type f -mmin -60' sh 2>/dev/null | wc -l)

changes=()
[[ -z $drift ]] || changes+=("$drift no longer match the repo; review with: omni dots status")
((edited == 0)) || changes+=("$edited files under ~/Dev/dotfiles/dotfiles changed in the last hour; review with: git -C ~/Dev/dotfiles status")

if ((${#changes[@]})); then
  message=$(printf '%s; ' "${changes[@]}")
  alert "Omarchy update changed dotfiles" "${message%; }"
fi
