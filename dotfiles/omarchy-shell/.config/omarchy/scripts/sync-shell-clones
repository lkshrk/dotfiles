#!/bin/bash
# Re-applies each cloned plugin's local.patch onto Omarchy's updated upstream files, so the clones pick up upstream fixes.
set -u

plugins="$HOME/.config/omarchy/plugins"
upstream_root=/usr/share/omarchy/shell/plugins

# clone id, upstream plugin dir relative to upstream_root, whether the clone mirrors that whole dir
clones=(
  "lkshrk.lock lock whole"
  "lkshrk.polkit polkit whole"
  "lkshrk.notifications notifications whole"
)

synced=()
conflicts=()

for entry in "${clones[@]}"; do
  read -r clone updir scope <<<"$entry"
  dir="$plugins/$clone"
  upstream="$upstream_root/$updir"
  baseline="$dir/upstream.sha256"
  [[ -f $baseline && -f $dir/local.patch && -d $upstream ]] || continue

  (cd "$upstream" && sha256sum --quiet --check "$baseline" >/dev/null 2>&1) && continue

  mapfile -t files < <(awk '{print $2}' "$baseline" | sort)
  if [[ $scope == whole ]]; then
    mapfile -t current < <(cd "$upstream" && find . -type f ! -name manifest.json -printf '%P\n' | sort)
    [[ ${files[*]} == "${current[*]}" ]] || { conflicts+=("$clone (files added or removed)"); continue; }
  fi

  work=$(mktemp -d)
  ok=1
  for f in "${files[@]}"; do
    [[ -f $upstream/$f ]] || { ok=0; break; }
    mkdir -p "$work/new/$(dirname "$f")" "$work/old/$(dirname "$f")"
    cp "$upstream/$f" "$work/new/$f"
    cp "$upstream/$f" "$work/old/$f"
  done
  ((ok)) && (cd "$work/new" && patch -p1 --fuzz=0 --quiet --no-backup-if-mismatch <"$dir/local.patch" >/dev/null 2>&1) || ok=0

  if ((ok)); then
    for f in "${files[@]}"; do
      cat "$work/new/$f" >"$(readlink -f "$dir/$f")"
    done
    (cd "$work" && diff -ru old new | sed -e 's|^--- old/\([^[:space:]]*\).*|--- a/\1|' -e 's|^+++ new/\([^[:space:]]*\).*|+++ b/\1|' -e '/^diff -ru /d') >"$(readlink -f "$dir/local.patch")"
    (cd "$upstream" && sha256sum "${files[@]}") >"$(readlink -f "$baseline")"
    synced+=("$clone")
  else
    conflicts+=("$clone")
  fi
  rm -rf "$work"
done

# omarchy-update restarts the shell right after the hooks, so the new QML loads then.
if ((${#synced[@]})); then
  notify-send "Shell clones updated" "Re-applied local changes onto Omarchy's new version: ${synced[*]}. Review and commit in ~/Dev/dotfiles."
fi
if ((${#conflicts[@]})); then
  notify-send -u critical "Shell clones need a manual re-sync" "Omarchy changed what these patch: ${conflicts[*]}. They still run the previous version."
fi
