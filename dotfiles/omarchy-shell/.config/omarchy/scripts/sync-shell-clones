#!/bin/bash
# Re-applies each cloned plugin's local.patch onto Omarchy's updated upstream files, so the clones pick up upstream fixes.
# A clone is only replaced when every file patches cleanly; otherwise it is left as is and the conflict is reported.
set -u

plugins="$HOME/.config/omarchy/plugins"
upstream_root=/usr/share/omarchy/shell/plugins

# clone id, upstream plugin dir relative to upstream_root
clones=(
  "lkshrk.lock lock"
  "lkshrk.polkit polkit"
  "lkshrk.notifications notifications"
  "lkshrk.workspaces bar/widgets"
)

synced=()
conflicts=()

for entry in "${clones[@]}"; do
  read -r clone updir <<<"$entry"
  dir="$plugins/$clone"
  upstream="$upstream_root/$updir"
  baseline="$dir/upstream.sha256"
  [[ -f $baseline && -f $dir/local.patch && -d $upstream ]] || continue

  (cd "$upstream" && sha256sum --quiet --check "$baseline" >/dev/null 2>&1) && continue

  work=$(mktemp -d)
  mapfile -t files < <(awk '{print $2}' "$baseline")
  for f in "${files[@]}"; do
    mkdir -p "$work/$(dirname "$f")"
    cp "$upstream/$f" "$work/$f"
  done

  if (cd "$work" && patch -p1 --quiet --no-backup-if-mismatch <"$dir/local.patch" >/dev/null 2>&1); then
    for f in "${files[@]}"; do
      cat "$work/$f" >"$(readlink -f "$dir/$f")"
    done
    (cd "$upstream" && sha256sum "${files[@]}") >"$(readlink -f "$baseline")"
    synced+=("$clone")
  else
    conflicts+=("$clone")
  fi
  rm -rf "$work"
done

if ((${#synced[@]})); then
  omarchy restart shell >/dev/null 2>&1
  notify-send "Shell clones updated" "Re-applied local changes onto Omarchy's new version: ${synced[*]}. Review and commit in ~/Dev/dotfiles."
fi
if ((${#conflicts[@]})); then
  notify-send -u critical "Shell clones need a manual re-sync" "Omarchy changed the lines these patch: ${conflicts[*]}. They still run the previous version."
fi
