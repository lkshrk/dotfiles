#!/bin/bash
# Falls back to Omarchy's stock plugin when a clone stops loading, since nothing else draws the lock screen or password prompts.
set -u

omarchy_shell() {
  quickshell list -a -j 2>/dev/null | jq -r \
    '[.[] | select(.config_path | startswith("/usr/share/omarchy/shell/"))] | max_by(.launch_time) // empty | .id'
}

log_of_current_shell() {
  local id
  id=$(omarchy_shell) && [[ -n $id ]] && cat "${XDG_RUNTIME_DIR}/quickshell/by-id/$id/log.log" 2>/dev/null
}

# The notification daemon lives in the shell, so alerts must not depend on it.
alert() {
  hyprctl notify 0 15000 "rgb(ff5555)" "$1: $2" >/dev/null 2>&1 || logger -t check-shell-clones "$1: $2"
}

fall_back() {
  local clone=$1 stock=$2 what=$3
  omarchy plugin disable "$clone" >/dev/null 2>&1
  omarchy plugin enable "$stock" >/dev/null 2>&1
  alert "$what clone failed to load" "Switched back to Omarchy's $stock. Re-sync $clone, then: omarchy plugin enable $clone"
}

enabled() {
  jq -e --arg id "$1" '.plugins[]? | select(.id == $id)' ~/.config/omarchy/shell.json >/dev/null 2>&1
}

load_failed() {
  log_of_current_shell | grep -q "service plugin load failed for $1"
}

for _ in $(seq 1 20); do
  [[ -n $(omarchy_shell) ]] && break
  sleep 1
done

if [[ -z $(omarchy_shell) ]]; then
  alert "Omarchy shell is not running" "No bar, lock screen or notifications. Start it with: omarchy-restart-shell"
  exit 0
fi

# The shell answers IPC a moment after it starts, so the lock gets a few seconds before it counts as broken.
lock_answers() {
  for _ in 1 2 3 4 5; do
    omarchy-shell lock status >/dev/null 2>&1 && return 0
    sleep 1
  done
  return 1
}

if enabled lkshrk.lock && ! lock_answers; then
  fall_back lkshrk.lock omarchy.lock "Lock screen"
fi

if enabled lkshrk.polkit && load_failed lkshrk.polkit; then
  fall_back lkshrk.polkit omarchy.polkit "Password prompt"
fi
