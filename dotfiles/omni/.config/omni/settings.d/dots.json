{
  "groups": [
    {
      "name": "core",
      "dots": [
        {
          "name": "omni",
          "path": "~/.config/omni",
          "ignore": [
            "*",
            "!/settings.json",
            "!/settings.d/"
          ]
        },
        {
          "name": "omni-apm",
          "path": "~/.config/omni",
          "hosts": {
            "topaz": {
              "package": "omni-apm@topaz"
            },
            "towerr": {
              "package": "omni-apm@topaz"
            }
          },
          "ignore": [
            "*",
            "!/apm.yml"
          ]
        }
      ]
    }
  ]
}
