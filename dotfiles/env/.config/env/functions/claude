claude() (
  export ANTHROPIC_BASE_URL="${LITELLM_BASE_URL:-https://api.ai.h-cloud.lan}"
  export CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY=1
  export ANTHROPIC_CUSTOM_MODEL_OPTION=free-auto
  export ANTHROPIC_CUSTOM_MODEL_OPTION_NAME='Free Auto'
  export ANTHROPIC_CUSTOM_MODEL_OPTION_DESCRIPTION='Ordered free-provider failover'

  "${ENV_DIR:-${ENV_NEXT_DIR:-$HOME/.config/env}}/bin/rbw-env" claude-api -- claude "$@"
)

cc() { claude "$@"; }

claude_sub() (
  unset ANTHROPIC_BASE_URL ANTHROPIC_AUTH_TOKEN ANTHROPIC_API_KEY \
    CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY ANTHROPIC_CUSTOM_MODEL_OPTION \
    ANTHROPIC_CUSTOM_MODEL_OPTION_NAME ANTHROPIC_CUSTOM_MODEL_OPTION_DESCRIPTION
  command claude "$@"
)

ccs() { claude_sub "$@"; }
