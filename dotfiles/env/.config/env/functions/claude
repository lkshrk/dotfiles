claude() (
  export ANTHROPIC_BASE_URL="${LITELLM_BASE_URL:-https://api.ai.h-cloud.lan}"
  export CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY=1

  "${ENV_DIR:-${ENV_NEXT_DIR:-$HOME/.config/env}}/bin/rbw-env" claude-api -- claude "$@"
)

# Interactive only: in scripts cc must stay the C compiler.
case $- in *i*) cc() { claude "$@"; } ;; esac

claude_hass() (
  unset ANTHROPIC_AUTH_TOKEN ANTHROPIC_API_KEY LITELLM_API
  export ANTHROPIC_BASE_URL="${LITELLM_BASE_URL:-https://api.ai.h-cloud.lan}"
  export CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY=1

  "${ENV_DIR:-${ENV_NEXT_DIR:-$HOME/.config/env}}/bin/rbw-env" claude-hass -- claude "$@"
)

# Hyphenated function names are not POSIX; this file is also sourced by sh.
alias cc-hass=claude_hass

claude_sub() (
  unset ANTHROPIC_BASE_URL ANTHROPIC_AUTH_TOKEN ANTHROPIC_API_KEY \
    CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY ANTHROPIC_CUSTOM_MODEL_OPTION \
    ANTHROPIC_CUSTOM_MODEL_OPTION_NAME ANTHROPIC_CUSTOM_MODEL_OPTION_DESCRIPTION
  "${ENV_DIR:-${ENV_NEXT_DIR:-$HOME/.config/env}}/bin/rbw-env" claude -- claude "$@"
)

ccs() { claude_sub "$@"; }
