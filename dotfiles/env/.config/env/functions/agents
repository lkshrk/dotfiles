# Claude's installer owns ~/.local/bin/claude, so claude and codex route here; omp and opencode use ~/.local/bin symlinks.
agent_run() { "${ENV_DIR:-${ENV_NEXT_DIR:-$HOME/.config/env}}/bin/agent-run" "$@"; }

claude() { agent_run claude "$@"; }
claude_hass() { agent_run claude-hass "$@"; }
claude_sub() { agent_run claude-sub "$@"; }
codex() { agent_run codex "$@"; }

ccs() { claude_sub "$@"; }
oc() { opencode "$@"; }
# Hyphenated function names are not POSIX; this file is also sourced by sh.
alias cc-hass=claude_hass
# Interactive only: in scripts cc must stay the C compiler.
case $- in *i*) cc() { claude "$@"; } ;; esac
