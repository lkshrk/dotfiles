#!/bin/sh
# Print the LiteLLM MCP auth header as JSON for Codex http_headers_helper.
set -eu

# Codex runs this without XDG_RUNTIME_DIR, and rbw then talks to a fresh, locked agent in /tmp.
if [ -z "${XDG_RUNTIME_DIR:-}" ] && [ -d "/run/user/$(id -u)" ]; then
  XDG_RUNTIME_DIR="/run/user/$(id -u)"
  export XDG_RUNTIME_DIR
fi

if [ -n "${LITELLM_API:-}" ]; then
  token=$LITELLM_API
elif command -v rbw >/dev/null 2>&1; then
  token=$(rbw get --folder ENV local-agents) || {
    printf '%s\n' 'litellm mcp: unable to read ENV/local-agents from rbw (vault locked?)' >&2
    exit 1
  }
else
  printf '%s\n' 'litellm mcp: set LITELLM_API or install rbw' >&2
  exit 1
fi

case "$token" in
  '' | *'"'* | *\\*)
    printf '%s\n' 'litellm mcp: credential is empty or not JSON-safe' >&2
    exit 1
    ;;
esac

printf '{"x-litellm-api-key":"%s"}\n' "$token"
