#!/bin/sh
# Keep the gateway credential out of config files and command-line arguments.
set -eu

LITELLM_API_KEY=$("${ENV_DIR:-${ENV_NEXT_DIR:-$HOME/.config/env}}/bin/local-agents-token")
LITELLM_API=$LITELLM_API_KEY
export LITELLM_API_KEY LITELLM_API
set -- "${OMP_BIN:-${BUN_INSTALL:-$HOME/.bun}/bin/omp}" "$@"
rbw_env="${ENV_DIR:-${ENV_NEXT_DIR:-$HOME/.config/env}}/bin/rbw-env"
# GitHub MCP is optional; launch without it where rbw is unavailable.
if command -v rbw >/dev/null 2>&1 && [ -x "$rbw_env" ]; then
  set -- env RBW_ENV_STRICT=0 "$rbw_env" --pairs gh-cli GITHUB_PERSONAL_ACCESS_TOKEN -- "$@"
fi
exec "$@"
