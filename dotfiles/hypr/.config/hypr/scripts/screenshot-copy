#!/usr/bin/env bash
# Screenshot to the clipboard only, with a short preview notice.
# Usage: screenshot-copy [smart|region|windows|fullscreen]
set -euo pipefail

DIR="${XDG_RUNTIME_DIR:-/tmp}/screenshots"
mkdir -p "$DIR"
find "$DIR" -name '*.png' -mmin +10 -delete 2>/dev/null || true

FILE="$(OMARCHY_SCREENSHOT_DIR="$DIR" omarchy-capture-screenshot "${1:-smart}" save)" || exit 0
[ -n "$FILE" ] && [ -f "$FILE" ] || exit 0

wl-copy --type image/png <"$FILE"
omarchy-notification-send "Screenshot copied to clipboard" --image "$FILE" -t 2000 || true
