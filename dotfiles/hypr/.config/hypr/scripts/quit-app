#!/usr/bin/env bash
# Close requests, not kills, so apps can still ask to save.
set -euo pipefail

class=$(hyprctl activewindow -j | jq -r '.class // empty')
[[ -n $class ]] || exit 0

batch=$(hyprctl clients -j | jq -r --arg class "$class" '
  [.[] | select(.class == $class) | "dispatch hl.dsp.window.close({ window = \"address:\(.address)\" })"]
  | join("; ")')
[[ -n $batch ]] || exit 0
hyprctl --batch "$batch" >/dev/null
