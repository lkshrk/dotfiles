// keyd turns Left Alt + a/o/u/s into AltGr, since apps treat Alt + letter as a shortcut, not text.
default partial alphanumeric_keys
xkb_symbols "intl" {
    include "us(intl)"
    name[Group1] = "English (US, intl., Mac ISO, umlauts)";

    key <TLDE> { [ section, plusminus, section, plusminus ] };
    key <LSGT> { [ grave, asciitilde, dead_grave, dead_tilde ] };

    key <AC01> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", [ a, A, adiaeresis, Adiaeresis ] };
    key <AD09> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", [ o, O, odiaeresis, Odiaeresis ] };
    key <AD07> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", [ u, U, udiaeresis, Udiaeresis ] };
    key <AC02> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", [ s, S, ssharp, U1E9E ] };
};
