#!/usr/bin/env bash
# Native messaging host for ~/.config/omarchy/webapp-links: one length-prefixed JSON message in, one reply out.
set -euo pipefail

length=$(head -c4 | od -An -tu4 | tr -d ' ')
url=$(head -c "${length:-0}" | jq -r '.url // empty')
printf '\x02\x00\x00\x00{}'
[[ $url =~ ^https?:// ]] || exit 0

# Helium opens a URL in its most recently active window, so activate the window named "Main" first.
main=$(hyprctl clients -j 2>/dev/null | jq -r '[.[] | select(.class == "helium" and .title == "Main")][0].address // empty' || true)
if [[ -n $main ]]; then
  hyprctl dispatch "hl.dsp.focus({ window = \"address:$main\" })" >/dev/null
  for _ in {1..20}; do
    [[ $(hyprctl activewindow -j | jq -r .address) == "$main" ]] && break
    sleep 0.01
  done
fi
# xdg-open would reach Helium through omarchy-launch-browser's systemd-run fallback, which is far slower.
setsid -f helium-browser "$url" </dev/null >/dev/null 2>&1
