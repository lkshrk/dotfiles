#!/usr/bin/env bash
# Chromium names an --app window's class after the URL, the same rule setup-omarchy.sh uses for StartupWMClass.
set -euo pipefail

[ $# -eq 1 ] || { echo "usage: $0 URL" >&2; exit 1; }
url=$1
rest="${url#*://}"
host="${rest%%/*}"
host="${host%%:*}"
url_path="/"
[[ "$rest" != */* ]] || url_path="/${rest#*/}"
class="chrome-${host}_${url_path//\//_}-Default"

# A local app's page that loads before its daemon listens never reconnects, e.g. PipeWeaver during session restore.
if [[ "$rest" =~ ^localhost:([0-9]+) ]]; then
  port=${BASH_REMATCH[1]}
  for _ in $(seq 30); do
    (exec 3<>"/dev/tcp/127.0.0.1/$port") 2>/dev/null && break
    sleep 0.5
  done
fi

exec "$HOME/.config/hypr/scripts/focus-app" "^${class//./\\.}\$" chromium --app="$url"
