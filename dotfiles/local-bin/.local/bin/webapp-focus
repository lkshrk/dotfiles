#!/usr/bin/env bash
# Helium names an --app window's class after the URL; setup-omarchy.sh reads it via --class for StartupWMClass.
set -euo pipefail

print_class=0
[[ ${1:-} != --class ]] || { print_class=1; shift; }
[ $# -eq 1 ] || { echo "usage: $0 [--class] URL" >&2; exit 1; }
url=$1
rest="${url#*://}"
host="${rest%%/*}"
host="${host%%:*}"
url_path="/"
[[ "$rest" != */* ]] || url_path="/${rest#*/}"
class="chrome-${host}_${url_path//\//_}-Default"
((print_class == 0)) || { printf '%s\n' "$class"; exit 0; }

# A local app's page that loads before its daemon is ready never reconnects, e.g. PipeWeaver during session restore.
if [[ "$rest" =~ ^localhost:([0-9]+) ]]; then
  port=${BASH_REMATCH[1]}
  for _ in $(seq 30); do
    (exec 3<>"/dev/tcp/127.0.0.1/$port") 2>/dev/null && break
    sleep 0.5
  done
  # PipeWeaver's server listens before its PipeWire manager is up; this answers 503 until then.
  if [[ $port == 14565 ]]; then
    for _ in $(seq 60); do
      curl -sfo /dev/null -m 1 "http://127.0.0.1:$port/api/get-devices" && break
      sleep 0.5
    done
  fi
fi

# Each app is its own Helium instance, so logins stay apart; its browser windows (class webapp-*) are hidden by hypr/rules.lua.
app_id="${host}${url_path%/}"
app_id="${app_id//\//_}"
profile="${XDG_DATA_HOME:-$HOME/.local/share}/webapps/$app_id"
mkdir -p "$profile/NativeMessagingHosts"
cat >"$profile/NativeMessagingHosts/com.lkshrk.open_url.json" <<EOF
{
  "name": "com.lkshrk.open_url",
  "description": "Open links from web apps in the default browser",
  "path": "$HOME/.local/bin/webapp-open-url",
  "type": "stdio",
  "allowed_origins": ["chrome-extension://kgmaedigpgooacompmffkjeipjpgiakj/"]
}
EOF

# Software rendering keeps these off the 10 GiB card's VRAM; Figma needs WebGL.
gpu_flags=(--disable-gpu)
[[ $host != *figma.com ]] || gpu_flags=()

exec "$HOME/.config/hypr/scripts/focus-app" "^${class//./\\.}\$" helium-browser \
  --user-data-dir="$profile" --class="webapp-$app_id" --no-first-run --no-default-browser-check "${gpu_flags[@]}" \
  --load-extension="$HOME/.config/omarchy/webapp-links" --app="$url"
