#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["websockets>=13"]
# ///
"""Chime and notify when the Home Assistant doorbell rings; `--test [rings]` fires it without connecting."""

import asyncio
import json
import os
import sys
import time
import urllib.request

import websockets

HASS_SERVER = os.environ.get("HASS_SERVER", "https://hass.h-cloud.io").rstrip("/")
ENTITY = os.environ.get("DOORBELL_ENTITY", "binary_sensor.haustur_offner_ring_action")
ASSETS = os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share"), "ha-doorbell")
SOUND = os.environ.get("DOORBELL_SOUND") or os.path.join(ASSETS, "dingdong.wav")
ICON = os.path.join(ASSETS, "icon.svg")
OPENER = os.environ.get("DOORBELL_OPENER", "lock.haustur_offner")
SINK = os.environ.get("DOORBELL_SINK", "pipeweaver_music")


def log(msg: str) -> None:
    print(msg, file=sys.stderr, flush=True)


ring_count = 0
ring_card_id = 0
last_ring = 0.0
waiter: asyncio.subprocess.Process | None = None
pending: set[asyncio.Task] = set()


async def notify_send(summary: str, body: str = "", *extra: str, stdout=None) -> asyncio.subprocess.Process:
    return await asyncio.create_subprocess_exec(
        "notify-send", "--app-name=Türklingel", f"--icon={ICON}", *extra, summary, body,
        stdout=stdout,
    )


async def notify() -> None:
    global ring_count, ring_card_id, last_ring, waiter
    now = time.monotonic()
    ring_count = ring_count + 1 if now - last_ring < 120 else 1
    last_ring = now
    summary = "Ding-Dong! Es klingelt" if ring_count == 1 else f"Ding-Dong! Schon {ring_count}× geklingelt"
    body = (
        f"<b>Haustür</b> · {time.strftime('%H:%M')} Uhr<br/>"
        "<i>Klicken zum Öffnen der Tür</i>"
    )
    replace = [f"--replace-id={ring_card_id}"] if ring_card_id else []
    if waiter and waiter.returncode is None:
        waiter.terminate()
    proc = waiter = await notify_send(
        summary, body, "--urgency=normal", "--print-id", *replace, "--action=default=Öffnen",
        stdout=asyncio.subprocess.PIPE,
    )
    assert proc.stdout
    first = (await proc.stdout.readline()).strip()
    if first.isdigit():
        ring_card_id = int(first)
    out, _ = await proc.communicate()
    if out.strip() == b"default":
        await door_dialog()


def call_service(domain: str, service: str, data: dict) -> None:
    req = urllib.request.Request(
        f"{HASS_SERVER}/api/services/{domain}/{service}",
        data=json.dumps(data).encode(),
        headers={"Authorization": f"Bearer {os.environ['HASS_TOKEN']}", "Content-Type": "application/json"},
        method="POST",
    )
    with urllib.request.urlopen(req, timeout=10):
        pass


async def door_dialog() -> None:
    proc = await asyncio.create_subprocess_exec(
        "omarchy-confirm", "Jemand steht an der Haustür. Soll ich öffnen?",
        "--title", "Ding-Dong!", "--icon", "\U000F009E",
        "--confirm", "Öffnen", "--confirm-icon", "\U000F081C", "--cancel", "Abbrechen",
        "--wiggle", "--timeout", "120",
    )
    if await proc.wait() != 0:
        return
    try:
        await asyncio.to_thread(call_service, "lock", "open", {"entity_id": OPENER})
        log("door opened")
        await notify_send("Tür wird geöffnet")
    except Exception as err:
        log(f"opening the door failed: {err}")
        await notify_send("Tür konnte nicht geöffnet werden", str(err))


async def chime() -> None:
    target = ["--target", SINK] if SINK else []
    proc = await asyncio.create_subprocess_exec("pw-play", *target, SOUND)
    await proc.wait()


async def alert() -> None:
    await asyncio.gather(notify(), chime(), return_exceptions=True)


async def listen(token: str, on_auth) -> None:
    ws_url = HASS_SERVER.replace("http", "ws", 1) + "/api/websocket"
    async with websockets.connect(ws_url, ping_interval=30, ping_timeout=20) as ws:
        await ws.recv()
        await ws.send(json.dumps({"type": "auth", "access_token": token}))
        reply = json.loads(await ws.recv())
        if reply.get("type") != "auth_ok":
            raise PermissionError(f"auth failed: {reply.get('message', reply.get('type'))}")
        on_auth()
        await ws.send(json.dumps({
            "id": 1,
            "type": "subscribe_trigger",
            "trigger": {"trigger": "state", "entity_id": ENTITY, "from": "off", "to": "on"},
        }))
        log(f"connected to {HASS_SERVER}, watching {ENTITY}")
        async for raw in ws:
            msg = json.loads(raw)
            if msg.get("type") == "result" and not msg.get("success"):
                raise RuntimeError(f"subscribe failed: {msg.get('error')}")
            if msg.get("type") == "event":
                log("ring")
                task = asyncio.create_task(alert())
                pending.add(task)
                task.add_done_callback(pending.discard)


async def main() -> int:
    if "--test" in sys.argv:
        rings = int(sys.argv[-1]) if sys.argv[-1].isdigit() else 1
        tasks = []
        for n in range(rings):
            if n:
                await asyncio.sleep(4)
            tasks.append(asyncio.create_task(alert()))
        await asyncio.gather(*tasks)
        return 0
    token = os.environ.get("HASS_TOKEN")
    if not token:
        log("HASS_TOKEN is not set")
        return 2
    delay = 5

    def reset_delay() -> None:
        nonlocal delay
        delay = 5

    while True:
        try:
            await listen(token, reset_delay)
        except PermissionError as err:
            delay = 300
            log(f"{err}; retrying in {delay}s")
        except Exception as err:
            log(f"Home Assistant unreachable ({type(err).__name__}: {err}); retrying in {delay}s")
        await asyncio.sleep(delay)
        delay = min(delay * 2, 300)


if __name__ == "__main__":
    sys.exit(asyncio.run(main()))
