[Unit]
Description=PipeWeaver audio mixer daemon
# Started before any output existed it got "start node error -22" for every channel.
After=pipewire.service pipewire-pulse.service wireplumber.service graphical-session.target
Wants=wireplumber.service
PartOf=pipewire.service graphical-session.target

[Service]
ExecStartPre=-/usr/bin/timeout 10 /usr/bin/sh -c 'until pactl list short sinks | grep -qv pipeweaver_; do sleep 1; done; sleep 1'
ExecStart=/usr/bin/pipeweaver-daemon --background
Restart=on-failure
RestartSec=5
# It hangs on SIGTERM once PipeWire is gone.
TimeoutStopSec=5

[Install]
WantedBy=graphical-session.target
