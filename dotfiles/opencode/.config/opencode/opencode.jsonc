{
  "$schema": "https://opencode.ai/config.json",
  "model": "local-agents/anthropic/claude-sonnet#high",
  "agents": {
    "title": { "model": "local-agents/anthropic/claude-sonnet" }
  },
  "policies": [
    { "action": "provider.use", "resource": "*", "effect": "deny" },
    { "action": "provider.use", "resource": "local-agents", "effect": "allow" }
  ],
  "instructions": [
    "~/.config/opencode/instructions/gateway-tools.md",
    "~/.claude/rules/h-cloud-kubectl.md"
  ],
  "providers": {
    "local-agents": {
      "name": "Local agents",
      "env": ["LITELLM_API_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://api.ai.h-cloud.lan/v1",
        // Injected by ~/.config/env/bin/opencode-local-agents; never stored here.
        "apiKey": "{env:LITELLM_API_KEY}"
      },
      "models": {
        "anthropic-auto": {
          "name": "anthropic-auto",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] },
          "limit": { "context": 1000000, "output": 128000 }
        },
        "anthropic/claude-fable": {
          "name": "anthropic/claude-fable",
          "package": "@opencode/ai/providers/anthropic",
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"], "reasoning": { "supported": true, "effort": ["low", "medium", "high"] } },
          "limit": { "context": 1000000, "output": 128000 }
        },
        "anthropic/claude-haiku": {
          "name": "anthropic/claude-haiku",
          "package": "@opencode/ai/providers/anthropic",
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"], "reasoning": { "supported": true, "effort": ["low", "medium", "high"] } },
          "limit": { "context": 200000, "output": 64000 }
        },
        "anthropic/claude-opus": {
          "name": "anthropic/claude-opus",
          "package": "@opencode/ai/providers/anthropic",
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"], "reasoning": { "supported": true, "effort": ["low", "medium", "high"] } },
          "limit": { "context": 1000000, "output": 128000 }
        },
        "anthropic/claude-sonnet": {
          "name": "anthropic/claude-sonnet",
          "package": "@opencode/ai/providers/anthropic",
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"], "reasoning": { "supported": true, "effort": ["low", "medium", "high"] } },
          "limit": { "context": 1000000, "output": 128000 }
        },
        "auto": {
          "name": "auto",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] },
          "limit": { "context": 1000000, "output": 128000 }
        },
        "moonshot/kimi": {
          "name": "moonshot/kimi",
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] },
          "limit": { "context": 1048576, "output": 131072 }
        },
        "openai-auto": {
          "name": "openai-auto",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] },
          "limit": { "context": 922000, "output": 128000 }
        },
        "openai/gpt-astra": {
          "name": "openai/gpt-astra",
          "package": "@opencode/ai/providers/openai/responses",
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"], "reasoning": { "supported": true, "effort": ["low", "medium", "high"] } },
          "limit": { "context": 922000, "output": 128000 }
        },
        "openai/gpt-luna": {
          "name": "openai/gpt-luna",
          "package": "@opencode/ai/providers/openai/responses",
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"], "reasoning": { "supported": true, "effort": ["low", "medium", "high"] } },
          "limit": { "context": 922000, "output": 128000 }
        },
        "openai/gpt-sol": {
          "name": "openai/gpt-sol",
          "package": "@opencode/ai/providers/openai/responses",
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"], "reasoning": { "supported": true, "effort": ["low", "medium", "high"] } },
          "limit": { "context": 922000, "output": 128000 }
        },
        "openai/gpt-terra": {
          "name": "openai/gpt-terra",
          "package": "@opencode/ai/providers/openai/responses",
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"], "reasoning": { "supported": true, "effort": ["low", "medium", "high"] } },
          "limit": { "context": 922000, "output": 128000 }
        },
        "opencode/deepseek": {
          "name": "opencode/deepseek",
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] },
          "limit": { "context": 1000000, "output": 384000 }
        },
        "opencode/glm": {
          "name": "opencode/glm",
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] },
          "limit": { "context": 1000000, "output": 131072 }
        },
        "opencode/minimax": {
          "name": "opencode/minimax",
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] },
          "limit": { "context": 1000000, "output": 131072 }
        },
        "opencode/qwen": {
          "name": "opencode/qwen",
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] },
          "limit": { "context": 1000000, "output": 131072 }
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "litellm-tools": {
        "type": "remote",
        "url": "https://api.ai.h-cloud.lan/mcp/",
        // APM's OpenCode adapter drops header helpers, so the wrapper-injected key is used.
        "headers": { "x-litellm-api-key": "{env:LITELLM_API_KEY}" }
      }
    }
  }
}
